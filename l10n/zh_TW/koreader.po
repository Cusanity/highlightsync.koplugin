#: ../_meta.lua:4
msgid   "HighlightSync"
msgstr  "高亮同步"

#: ../_meta.lua:5
msgid   "HighlightSync is a plugin for KOReader that synchronizes and merges your highlights, notes, and bookmarks across multiple devices or cloud backup locations."
msgstr  "HighlightSync 是一個 KOReader 插件，可跨多台裝置或雲端備份位置同步和合併您的高亮、筆記和書籤。"

#: ../main.lua:69
msgid   "Highlight Sync"
msgstr  "高亮同步"

#: ../main.lua:142
msgid   "Sync Cloud"
msgstr  "雲端設置"

#: ../main.lua:162
msgid   "Delete"
msgstr  "刪除"

#: ../main.lua:166
msgid   "Delete server info?"
msgstr  "刪除伺服器資訊？"

#: ../main.lua:167
msgid   "Cancel"
msgstr  "取消"

#: ../main.lua:179
msgid   "Edit"
msgstr  "編輯"

#: ../main.lua:186
msgid   "Close"
msgstr  "關閉"

#: ../main.lua:193
#, lua-format
msgid   "Cloud storage:\n%1\n\nFolder path:\n%2\n\nSet up the same cloud folder on each device to sync across your devices."
msgstr  "雲端儲存：\n%1\n\n資料夾路徑：\n%2\n\n在每台裝置上設置相同的雲端資料夾以實現跨裝置同步。"

#: ../main.lua:205
msgid   "Sync Highlights"
msgstr  "同步"

#: ../main.lua:127
msgid   "Sync Highlights Now"
msgstr  "立即同步高亮"

#: ../main.lua:128
msgid   "Synchronize highlights with the cloud."
msgstr  "將高亮同步至雲端。"

#: ../main.lua:304
msgid   "Not available"
msgstr  "不適用"

#: ../main.lua:310
msgid   "Never"
msgstr  "從不"

#: ../main.lua:484
msgid   "Settings"
msgstr  "設定"

#: ../main.lua:487
msgid   "Automatically sync highlights"
msgstr  "自動同步高亮"

#: ../main.lua:518
msgid   "Automatically sync highlights on open, close, resume, suspend, and network changes."
msgstr  "在開啟、關閉、恢復、暫停和網路變更時自動同步高亮。"

#: ../main.lua:497
msgid   "You will have to switch the 'Action when Wi-Fi is off' Network setting to 'turn on' to be able to enable this feature!"
msgstr  "您需要將網路設定中的「Wi-Fi 關閉時的動作」改為「開啟」才能啟用此功能！"

#: ../main.lua:514
#, lua-format
msgid   "Periodically sync every # pages (%1)"
msgstr  "每 # 頁自動同步（%1）"

#: ../main.lua:550
msgid   "Number of page turns between automatic syncs.\nSet to 0 to disable page-based syncing."
msgstr  "兩次自動同步之間的翻頁次數。\n設為 0 則停用基於頁數的同步。"

#: ../main.lua:528
msgid   "Set"
msgstr  "設定"

#: ../main.lua:529
msgid   "Pages between syncs"
msgstr  "同步間隔頁數"

#: ../main.lua:425
msgid   "Highlights synchronized."
msgstr  "高亮同步成功"
