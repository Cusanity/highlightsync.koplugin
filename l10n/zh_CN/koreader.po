#: ../_meta.lua:5
msgid   "Synchronize book highlights across devices using cloud storage (WebDAV/Dropbox)."
msgstr  "使用云存储（WebDAV/Dropbox）跨设备同步书籍高亮。"

#: ../main.lua:69
msgid   "Highlight Sync"
msgstr  "高亮同步"

#: ../main.lua:119
msgid   "Syncing book highlights. This may take a while."
msgstr  "正在同步书籍高亮，请稍候。"

#: ../main.lua:142
msgid   "Sync Cloud"
msgstr  "云端设置"

#: ../main.lua:162
msgid   "Delete"
msgstr  "删除"

#: ../main.lua:166
msgid   "Delete server info?"
msgstr  "删除服务器信息？"

